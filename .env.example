# =============================================================================
# Sree Laxmi Developers — Environment Configuration (.env.example)
# Copy this file to `.env` for local or Node.js production deployment.
# Do NOT commit real secrets or database credentials to version control.
# =============================================================================

# Server Port (Hostinger Node.js hosting automatically assigns PORT at runtime)
PORT=3000

# Runtime Environment ("production" or "development")
NODE_ENV="production"

# Allowed Frontend Origin for CORS (set to your live domain in production)
FRONTEND_URL="https://sreelaxmidevelopers.com"

# Frontend API Base URL (optional; leave empty "" when frontend and API share the same domain,
# or set to your external Node.js API URL such as "https://api.sreelaxmidevelopers.com")
VITE_API_BASE_URL=""

# Optional MongoDB Atlas Connection String (only required if persisting enquiries to MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/sree_laxmi_developers?retryWrites=true&w=majority"

# Optional Notification / Contact Receiver Email
CONTACT_RECEIVER_EMAIL="contact@sreelaxmidevelopers.com"

